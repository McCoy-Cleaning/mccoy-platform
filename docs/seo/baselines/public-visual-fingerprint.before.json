        "sectionId": "home",
        "sectionClassName": "relative isolate flex min-h-[100svh] items-center overflow-hidden pt-24"
      },
      "markers": [
        "section#home.min-h-[100svh]",
        "bg-grid opacity-40",
        "SECTION_PAGE_RAIL grid lg:grid-cols-12"
      ]
    },
