{
  "enforceAppIsolation": true,
  "forbidPackageSourceDeepImports": true,
  "forbidRelativeBoundaryEscape": true,
  "allowCycles": [
    "apps/admin/src/router\\.tsx -> apps/admin/src/routeTree\\.gen\\.ts -> apps/admin/src/router\\.tsx",
    "apps/storefront/src/router\\.tsx -> apps/storefront/src/routeTree\\.gen\\.ts -> apps/storefront/src/router\\.tsx"
  ],
  "exceptions": [],
  "zones": [
    {
      "name": "example-domain-is-framework-free",
      "enabled": false,
      "from": [
        "packages/domain/**"
      ],
      "deny": [
        "react",
        "next",
        "express",
        "@prisma/client",
        "packages/infrastructure/**"
      ]
    },
    {
      "name": "storefront-forbids-cms-editor",
      "enabled": true,
      "from": [
        "apps/storefront/**"
      ],
      "deny": [
        "@mccoy/cms-editor",
        "@mccoy/cms-editor/**"
      ]
    },
    {
      "name": "renderer-forbids-cms-editor",
      "enabled": true,
      "from": [
        "packages/cms-renderer/**"
      ],
      "deny": [
        "@mccoy/cms-editor",
        "@mccoy/cms-editor/**"
      ]
    },
    {
      "name": "schema-forbids-react-apps",
      "enabled": true,
      "from": [
        "packages/cms-schema/**"
      ],
      "deny": [
        "react",
        "react-dom",
        "react/*",
        "@mccoy/storefront",
        "@mccoy/admin",
        "@mccoy/cms-editor"
      ]
    }
  ]
}
