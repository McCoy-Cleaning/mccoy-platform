{
  "enforceAppIsolation": true,
  "forbidPackageSourceDeepImports": true,
  "forbidRelativeBoundaryEscape": true,
  "allowCycles": [
    "apps/admin/src/router\\.tsx -> apps/admin/src/routeTree\\.gen\\.ts -> apps/admin/src/router\\.tsx",
    "apps/storefront/src/router\\.tsx -> apps/storefront/src/routeTree\\.gen\\.ts -> apps/storefront/src/router\\.tsx"
  ],
  "exceptions": [],
  "zones": [
    {
      "name": "example-domain-is-framework-free",
      "enabled": false,
      "from": [
        "packages/domain/**"
      ],
      "deny": [
        "react",
        "next",
        "express",
        "@prisma/client",
        "packages/infrastructure/**"
      ]
    }
  ]
}
