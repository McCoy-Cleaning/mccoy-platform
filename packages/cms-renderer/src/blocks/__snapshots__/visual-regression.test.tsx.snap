exports[`CMS visual regression (HTML snapshots) > Hero default 1`] = `"<section id="home" data-cms-block-type="hero" data-cms-header-mode="block" data-cms-surface-mode="none" data-cms-width-mode="fullBleed" class="relative isolate flex min-h-[100svh] items-center overflow-hidden pt-24"><div class="absolute inset-0 -z-10 bg-grid opacity-40"></div><div class="absolute inset-0 -z-10 bg-gradient-to-b from-background via-background to-background/90"></div><div aria-hidden="true" class="pointer-events-none absolute -top-32 -right-24 -z-10 hidden h-[34rem] w-[34rem] rounded-full bg-primary/20 blur-[90px] md:block"></div><div aria-hidden="true" class="pointer-events-none absolute bottom-10 left-1/3 -z-10 hidden h-72 w-72 rounded-full bg-primary/12 blur-[80px] lg:block"></div><div aria-hidden="true" class="pointer-events-none absolute right-10 top-1/4 -z-10 hidden lg:block"><div class="relative h-72 w-72"><div class="absolute inset-0 rounded-full border border-primary/30"></div><div class="absolute inset-6 rounded-full border border-primary/20"></div><div class="absolute inset-16 rounded-full bg-gradient-to-br from-primary/40 to-primary/0 blur-2xl"></div></div></div><div class="mx-auto w-full max-w-[96rem] px-5 sm:px-8 lg:px-10 xl:px-12 grid w-full items-center gap-12 py-20 lg:grid-cols-12"><div class="lg:col-span-7"><div class="group inline-flex items-center gap-2 rounded-full border border-primary/40 bg-primary/10 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.22em] text-primary shadow-[0_0_40px_-10px_rgba(63,182,242,0.6)] backdrop-blur"><span class="relative flex h-2 w-2"><span class="absolute inline-flex h-full w-full motion-safe:animate-ping rounded-full bg-primary opacity-75"></span><span class="relative inline-flex h-2 w-2 rounded-full bg-primary"></span></span><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3l1.2 3.6L17 8l-3.8 1.4L12 13l-1.2-3.6L7 8l3.8-1.4L12 3zM18.5 13l.7 2.1 2.1.7-2.1.7-.7 2.1-.7-2.1-2.1-.7 2.1-.7.7-2.1zM6.5 14l.6 1.8 1.8.6-1.8.6-.6 1.8-.6-1.8-1.8-.6 1.8-.6.6-1.8z" fill="currentColor"></path></svg><span>Live Clean</span></div><h1 data-testid="hero-heading" class="font-display mt-6 text-6xl leading-[0.98] tracking-tight text-white sm:text-7xl lg:text-[5.75rem] xl:text-[6.5rem]">McCoy Cleaning, <span class="relative inline-block bg-gradient-to-br from-primary via-primary to-white/90 bg-clip-text text-transparent">schoonmaakbedrijf in Twente.<span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-full rounded-full bg-primary/70"></span></span></h1><p class="mt-8 max-w-xl whitespace-pre-line text-lg text-white/75 md:text-xl">Al meer dan 25 jaar staan wij voor schoonmaak met karakter — uitgevoerd door een vast eigen team, met professionele middelen en een onmiskenbaar oog voor detail. Geen onderaannemers, geen losse krachten: alleen vakmensen die uw pand behandelen alsof het hun eigen pand is. Vanuit Oldenzaal actief in heel Twente.</p><div class="mt-9 flex flex-wrap gap-3"><a href="/services" class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/5 px-7 py-4 text-sm font-semibold text-white backdrop-blur transition hover:border-primary/40 hover:bg-white/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background">Bekijk onze diensten</a></div><div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-3 text-xs uppercase tracking-[0.2em] text-white/55 justify-center lg:justify-start"><span class="flex items-center gap-2"><svg class="h-3.5 w-3.5 text-primary" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.75"></circle><path d="M8.5 12.2l2.2 2.2 4.8-5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg>25+ Jaar ervaring</span><span class="flex items-center gap-2"><svg class="h-3.5 w-3.5 text-primary" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.75"></circle><path d="M8.5 12.2l2.2 2.2 4.8-5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg>100% Vast eigen team</span><span class="flex items-center gap-2"><svg class="h-3.5 w-3.5 text-primary" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.75"></circle><path d="M8.5 12.2l2.2 2.2 4.8-5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg>160+ Tevreden klanten</span></div></div><div class="relative lg:col-span-5"><div class="relative mx-auto max-w-md"><div class="relative overflow-hidden rounded-[2rem] border border-white/15 shadow-[0_30px_80px_-20px_rgba(63,182,242,0.4)]"><div class="flex items-center justify-center overflow-hidden bg-white/[0.03] aspect-[4/3] w-full bg-black/35"><img src="/images/cms/hero-cleaning.jpg" class="h-full w-full object-contain object-contain object-center" loading="lazy" decoding="async" alt="McCoy Cleaning professional at work"/></div><div class="absolute inset-0 bg-gradient-to-t from-background/60 via-transparent to-transparent"></div></div><div class="absolute -bottom-6 -left-6 hidden rounded-2xl border border-white/15 bg-card/95 px-5 py-4 shadow-2xl sm:block"><div class="flex items-center gap-3"><div class="flex h-10 w-10 items-center justify-center rounded-xl bg-primary/20 text-primary"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="9" r="5.25" stroke="currentColor" stroke-width="1.75"></circle><path d="M9.2 13.6L8 20l4-2.2L16 20l-1.2-6.4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg></div><div><div class="font-display text-2xl leading-none text-white">25+</div><div class="mt-1 text-[10px] uppercase tracking-[0.2em] text-white/60">Jaar ervaring</div></div></div></div><div class="absolute -top-4 -right-4 hidden rounded-2xl border border-primary/30 bg-primary/20 px-4 py-3 sm:block"><div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-white"><svg class="h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3.5l7 2.5v6.2c0 4.1-2.8 7.8-7 8.8-4.2-1-7-4.7-7-8.8V6L12 3.5z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"></path><path d="M9.5 12.1l1.9 1.9 3.6-3.8" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg> Gecertificeerd</div></div></div></div></div><div class="absolute bottom-6 left-1/2 -translate-x-1/2" aria-hidden="true"><div class="h-10 w-6 rounded-full border border-white/20 p-1"><div class="mx-auto h-2 w-1 rounded-full bg-primary motion-safe:animate-bounce"></div></div></div></section>"`;

