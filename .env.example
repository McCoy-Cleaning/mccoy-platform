# Website form + admin reply email (Nodemailer / SMTP)
# Public forms notify FORM_TO_EMAIL; admin replies + staff invites use the same SMTP account.
# For Microsoft 365, SMTP may still work with username/password while IMAP basic auth does not.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
# SMTP_SECURE=false
# Optional explicit auth user (defaults to SMTP_FROM_EMAIL)
# SMTP_USER=
# Either SMTP_PASS or SMTP_PASSWORD — never commit real values
SMTP_PASSWORD=
# SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=McCoy Website
SMTP_REPLY_TO=
FORM_TO_EMAIL=
# Optional From override (otherwise SMTP_FROM_NAME <SMTP_FROM_EMAIL>)
# FORM_FROM_EMAIL=McCoy Website <you@example.com>
# Optional: force reply delivery while testing
# Dev-only: redirect form *reply* mail to this inbox (Aanvragen). Does NOT apply to staff invites/resets.
# FORM_REPLY_FORCE_TO=
# (Subject/body will note the intended submitter. Remove before production.)

# ---------------------------------------------------------------------------
# Admin → Aanvragen mail provider
# FORM_INBOX_PROVIDER=imap|graph|auto (default: auto)
# - imap  — force IMAP read + SMTP send (Gmail App Password style; ignore Graph env)
# - graph — Graph for inbox list/detail/thread (SMTP may still send replies)
# - auto  — try Graph when configured; fall back to IMAP only when host is not M365
#
# Microsoft 365 / Exchange Online: use graph (or auto + Graph credentials).
# M365 blocks IMAP basic auth — FORM_INBOX_PROVIDER=imap will fail fast for
# outlook.office365.com. Keep SMTP_* for outbound notifications/replies.
#
# FORM_INBOX_PROVIDER=graph
# Website form staff notifications prefer Graph Mail.Send as GRAPH_MAILBOX
# (same Entra app as Aanvragen). SMTP is only a fallback when Graph send fails
# or Graph is not configured. Avoids M365 SMTP AUTH / MFA issues.
# Debug only — show every Graph mailbox message in Aanvragen (not just form notifications):
# FORM_INBOX_SHOW_ALL=1

# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Microsoft Graph (required for Admin → Aanvragen reads on Microsoft 365)
# Entra app registration (e.g. McCoyAdmin-IMAP-SanderMailbox-Prod) checklist:
#   1) API permissions → Microsoft Graph → Application permissions:
#        Mail.Read  (list/detail/thread)
#        Mail.Send  (form notifications + admin replies as GRAPH_MAILBOX)
#        Mail.ReadWrite (verwijderen uit Aanvragen + markeren als gelezen)
#   2) Grant admin consent for the tenant
#   3) Allow the app to open GRAPH_MAILBOX (Exchange Application Access Policy
#      or equivalent) so GET /users/{mailbox}/messages works
#   4) Client credentials: TENANT_ID + CLIENT_ID|APPLICATION_ID + CLIENT_SECRET
# Accepted aliases: MICROSOFT_GRAPH_* | AZURE_* | MS_* | bare TENANT_ID/CLIENT_ID/CLIENT_SECRET
# Also: APPLICATION_ID (Azure Portal "Application (client) ID")
# ---------------------------------------------------------------------------
# MICROSOFT_GRAPH_TENANT_ID=
# MICROSOFT_GRAPH_CLIENT_ID=
# MICROSOFT_GRAPH_CLIENT_SECRET=
# Or:
# TENANT_ID=
# CLIENT_ID=
# APPLICATION_ID=
# CLIENT_SECRET=
# Mailbox UPN / SMTP address the app may access (defaults to SMTP_USER / SMTP_FROM_EMAIL):
# GRAPH_MAILBOX=sander@mccoy.nl

# Form inbox sync (Admin → Aanvragen) — IMAP when Graph is unset or for Gmail-style hosts
# Optional when SMTP_* is set — IMAP host is derived from SMTP_HOST:
#   smtp.gmail.com → imap.gmail.com
#   smtp.office365.com → outlook.office365.com (IMAP basic auth blocked on M365 — use Graph)
# Note: Microsoft 365 blocks IMAP basic auth; SMTP AUTH with a licensed mailbox
# user (SMTP_USER) may still work for send. Prefer FORM_INBOX_PROVIDER=graph for reads.
# Override if needed (Gmail):
# FORM_INBOX_HOST=imap.gmail.com
FORM_INBOX_HOST=
FORM_INBOX_PORT=993
# FORM_INBOX_USER=
# FORM_INBOX_PASS=
# FORM_INBOX_MAILBOX=INBOX

# Admin authentication
# Primary path: Supabase Auth staff login (email + password + MFA) when
# SUPABASE_* + VITE_SUPABASE_* are set — see docs/staff-identity-phase1.md.
# Legacy ADMIN_* is used only when Supabase is unset, or ADMIN_LEGACY_AUTH=true.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# ADMIN_LEGACY_AUTH=true

# Two application surfaces (monorepo: apps/storefront + apps/admin)
# Production mapping (DNS/CDN should point each host at the matching app):
#   PUBLIC_HOST=www.mccoy.nl,mccoy.nl  → apps/storefront
#   ADMIN_HOST=admin.mccoy.nl          → apps/admin
ADMIN_HOST=admin.mccoy.nl
PUBLIC_HOST=www.mccoy.nl,mccoy.nl
# auto = localhost allows both surfaces; strict = enforce hosts everywhere
HOST_ENFORCE=auto

# Storefront crawl / indexing (SEO)
# Default: index only when VERCEL_ENV=production. Preview/local stay noindex.
# Staging Vercel projects that use a production branch MUST set:
#   MCCOY_ALLOW_INDEXING=0
# Emergency allow on a non-Vercel host (rare): MCCOY_ALLOW_INDEXING=1
# MCCOY_ALLOW_INDEXING=

# Vite client origins for CMS preview postMessage (admin iframe → storefront /cms-preview)
# Local dev: storefront :5173, admin :5174
# Local production preview/start: storefront :4173, admin :4174
# Rebuild after changing these — VITE_* values are baked into the client bundle.
VITE_STOREFRONT_ORIGIN=http://localhost:5173
VITE_ADMIN_ORIGIN=http://localhost:5174

# Optional: absolute path for website-requests JSON store (default: <repo>/.data)
# Both storefront form submit and structured request persistence share this directory.
# Aanvragen UI primarily reads Graph (M365) or IMAP; JSON remains a reliability backup.
# MCCOY_DATA_DIR=

# CMS content AI (admin only — Groq). Never expose GROQ_API_KEY to VITE_* / the browser.
# Create a free key at https://console.groq.com — NL copy + NL→EN drafts (never auto-publishes).
GROQ_API_KEY=
# Optional model override (default: openai/gpt-oss-20b)
# GROQ_MODEL=openai/gpt-oss-20b

# CMS public site origin (canonical / hreflang / sitemap). Defaults to https://www.mccoy.nl in DB seed.
# CMS_SITE_ORIGIN=https://www.mccoy.nl
# Optional: absolute path for CMS published JSON when Supabase is not configured (default: <repo>/.data)
# MCCOY_DATA_DIR=

# Supabase (Project Settings → API)
# Use the project URL + publishable key for browser/SSR clients (RLS applies).
# Never put the service-role / secret key in VITE_* or any browser bundle.
# If SUPABASE_URL points at a deleted/paused project (getaddrinfo ENOTFOUND),
# the storefront falls back to the local file CMS (MCCOY_DATA_DIR / .data).
# For file-only local CMS, leave SUPABASE_SECRET_KEY empty.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only privileged client (migrations, staff invites, bootstrap). Never use VITE_*.
SUPABASE_SECRET_KEY=
# One-time Supabase staff identity bootstrap (creates Auth user + public.users).
# After bootstrap, log in at /admin/login with that email/password (not ADMIN_*).
# Remove after use:
# BOOTSTRAP_SUPER_ADMIN_EMAIL=
# BOOTSTRAP_SUPER_ADMIN_PASSWORD=
# BOOTSTRAP_SUPER_ADMIN_NAME=
# BOOTSTRAP_CONFIRM=CREATE_FIRST_SUPER_ADMIN
# Invite accept page (must be listed under Supabase Auth → URL Configuration → Redirect URLs).
# MUST include the path `/admin/invite` — a bare origin redirects to login.
# Use an absolute URL with scheme (https://…). Bare hostnames break Auth redirects
# ({"error":"requested path is invalid"} — host becomes a path on *.supabase.co).
# McCoy emails embed direct app links (`/admin/invite?token_hash=&type=`) so invitees
# never pass through Supabase-hosted verify pages; keep this URL allow-listed anyway.
# STAFF_INVITE_REDIRECT_URL=http://localhost:5174/admin/invite
# Preview/prod example:
# STAFF_INVITE_REDIRECT_URL=https://mccoy-platform-admin-git-development-mccoy1.vercel.app/admin/invite
# Optional dedicated From for staff invites (defaults to FORM_FROM_EMAIL)
# STAFF_INVITE_FROM_EMAIL=McCoy Admin <noreply@mccoy.nl>
# Absolute logo URL in transactional mail (defaults to VITE_STOREFRONT_ORIGIN + /images/cms/logo-mccoy.png,
# then https://www.mccoy.nl/images/cms/logo-mccoy.png). Same mark is used for Graph and SMTP invites.
# EMAIL_BRAND_LOGO_URL=https://www.mccoy.nl/images/cms/logo-mccoy.png
# Staff invites and password resets are sent via McCoy Graph/SMTP only (never Supabase Auth SMTP).
# Requires the same Mail.Send / SMTP credentials as form notifications (see GRAPH_* / SMTP_* above).
# Outbound staff mail uses saveToSentItems=true — copies appear in GRAPH_MAILBOX → Verzonden items
# (form notifications intentionally skip Sent Items to avoid Aanvragen duplicates).
# STAFF_INVITE_FROM_EMAIL=McCoy Admin <noreply@your-domain>
# Optional: force branded generateLink-first when Graph Mail.Send is confirmed:
# STAFF_INVITE_BRANDED_FIRST=1
# Legacy: npm run apply:auth-invite-template only needed if you still use Supabase Auth mail (not recommended).

# Required for browser Supabase Auth (same publishable values as server; never secret):
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
