{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && npm ci",
  "buildCommand": "cd ../.. && npm run build -w @mccoy/storefront",
  "ignoreCommand": "node ../../scripts/vercel-ignore.mjs storefront",
  "redirects": [
    {
      "source": "/cleaning",
      "has": [{ "type": "host", "value": "www.mccoy.nl" }],
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/cleaning/",
      "has": [{ "type": "host", "value": "www.mccoy.nl" }],
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/cleaning",
      "has": [{ "type": "host", "value": "mccoy.nl" }],
      "destination": "https://www.mccoy.nl/services",
      "permanent": true
    },
